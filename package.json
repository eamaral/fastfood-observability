{
  "name": "fastfood-observability",
  "version": "1.0.0",
  "description": "API simples de pedidos FastFood para aulas de observability (Prometheus, Grafana, Alloy), focada em execução local via docker-compose.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --coverage --coverageReporters=lcov --coverageReporters=text"
  },
  "keywords": [
    "fastfood",
    "observability",
    "prometheus",
    "grafana",
    "node",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "mysql2": "3.23.1",
    "prom-client": "^15.1.3",
    "sequelize": "6.37.8",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "brace-expansion@^1.1.12": "1.1.18",
    "browserslist@^4.28.1": "4.28.7",
    "flatted@^3.3.4": "3.4.2",
    "form-data@^4.0.5": "4.0.6",
    "js-yaml@^3.14.2": "3.15.2",
    "js-yaml@^4.1.1": "4.3.2",
    "lodash@^4.17.21": "4.18.0",
    "path-to-regexp@^0.1.12": "0.1.13",
    "picomatch@^2.3.1": "2.3.2",
    "baseline-browser-mapping@^2.10.0": "2.11.0",
    "dottie@^2.0.6": "2.0.7"
  }
}
